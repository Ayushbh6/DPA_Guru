{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "DRAFT",
        "REVIEWED",
        "APPROVED"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "ChecklistCategory": {
      "enum": [
        "Scope, Roles & Instructions",
        "Subprocessors & Personnel",
        "Security & Confidentiality",
        "Data Subject Rights & Assistance",
        "Incidents & Breach Notification",
        "International Transfers & Localization",
        "Retention, Deletion & Exit",
        "Audit, Compliance & Liability"
      ],
      "title": "ChecklistCategory",
      "type": "string"
    },
    "ChecklistGovernance": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "approval_status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "change_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Note"
        }
      },
      "required": [
        "owner",
        "approval_status",
        "policy_version"
      ],
      "title": "ChecklistGovernance",
      "type": "object"
    },
    "ChecklistItem": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "pattern": "^[A-Z0-9_.-]+$",
          "title": "Check Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ChecklistCategory",
          "description": "One approved checklist category from the fixed DPA category taxonomy."
        },
        "legal_basis": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Legal Basis",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/ChecklistSeverity"
        },
        "evidence_hint": {
          "minLength": 1,
          "title": "Evidence Hint",
          "type": "string"
        },
        "pass_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Pass Criteria",
          "type": "array"
        },
        "fail_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fail Criteria",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ChecklistSource"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "applicability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicability"
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/CriteriaPriority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected_evidence": {
          "items": {
            "$ref": "#/$defs/ExpectedEvidence"
          },
          "title": "Expected Evidence",
          "type": "array"
        },
        "likely_document_types": {
          "items": {
            "type": "string"
          },
          "title": "Likely Document Types",
          "type": "array"
        },
        "vendor_context_factors": {
          "items": {
            "type": "string"
          },
          "title": "Vendor Context Factors",
          "type": "array"
        },
        "profile_references": {
          "items": {
            "type": "string"
          },
          "title": "Profile References",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "title",
        "category",
        "legal_basis",
        "required",
        "severity",
        "evidence_hint",
        "pass_criteria",
        "fail_criteria",
        "sources"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "ChecklistSeverity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "MANDATORY"
      ],
      "title": "ChecklistSeverity",
      "type": "string"
    },
    "ChecklistSource": {
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "authority": {
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "source_excerpt": {
          "minLength": 1,
          "title": "Source Excerpt",
          "type": "string"
        },
        "interpretation_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpretation Notes"
        }
      },
      "required": [
        "source_type",
        "authority",
        "source_ref",
        "source_url",
        "source_excerpt"
      ],
      "title": "ChecklistSource",
      "type": "object"
    },
    "CriteriaDocumentInventoryItem": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "document_type": {
          "minLength": 1,
          "title": "Document Type",
          "type": "string"
        },
        "lifecycle_status": {
          "minLength": 1,
          "title": "Lifecycle Status",
          "type": "string"
        },
        "is_primary": {
          "title": "Is Primary",
          "type": "boolean"
        },
        "parsing_status": {
          "enum": [
            "pending",
            "processing",
            "parsed",
            "failed"
          ],
          "title": "Parsing Status",
          "type": "string"
        },
        "page_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "token_count_estimate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Count Estimate"
        }
      },
      "required": [
        "document_id",
        "display_name",
        "document_type",
        "lifecycle_status",
        "is_primary",
        "parsing_status"
      ],
      "title": "CriteriaDocumentInventoryItem",
      "type": "object"
    },
    "CriteriaPriority": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "CriteriaPriority",
      "type": "string"
    },
    "CriteriaValidationWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        },
        "document_types": {
          "items": {
            "type": "string"
          },
          "title": "Document Types",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message",
        "severity"
      ],
      "title": "CriteriaValidationWarning",
      "type": "object"
    },
    "ExpectedEvidence": {
      "additionalProperties": false,
      "properties": {
        "document_types": {
          "items": {
            "type": "string"
          },
          "title": "Document Types",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "title": "ExpectedEvidence",
      "type": "object"
    },
    "ReviewProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "required_document_types": {
          "items": {
            "type": "string"
          },
          "title": "Required Document Types",
          "type": "array"
        },
        "optional_document_types": {
          "items": {
            "type": "string"
          },
          "title": "Optional Document Types",
          "type": "array"
        },
        "mandatory_categories": {
          "items": {
            "type": "string"
          },
          "title": "Mandatory Categories",
          "type": "array"
        },
        "contextual_categories": {
          "items": {
            "type": "string"
          },
          "title": "Contextual Categories",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "version",
        "name"
      ],
      "title": "ReviewProfile",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "LAW",
        "GUIDELINE",
        "INTERNAL_POLICY"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "governance": {
      "$ref": "#/$defs/ChecklistGovernance"
    },
    "review_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "context_snapshot": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Snapshot"
    },
    "document_inventory": {
      "items": {
        "$ref": "#/$defs/CriteriaDocumentInventoryItem"
      },
      "title": "Document Inventory",
      "type": "array"
    },
    "validation_warnings": {
      "items": {
        "$ref": "#/$defs/CriteriaValidationWarning"
      },
      "title": "Validation Warnings",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ChecklistItem"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    }
  },
  "required": [
    "version",
    "governance",
    "checks"
  ],
  "title": "ChecklistDocument",
  "type": "object"
}